# Makefile — spike bare-metal litmus test harness
#
# Usage:
#   make LITMUS=path/to/test.litmus        # generate, compile, run
#   make run   LITMUS=path/to/test.litmus  # same as above
#   make clean
#
# The harness replaces:
#   affinity.c  → affinity_stub.c  (no OS affinity calls)
#   utils.c     → utils.c + spike_hart.c  (bare-metal launch/join/mmap_exec)
#   startup     → startup.S  (multi-hart bare-metal entry)
#   syscalls    → syscalls.c  (HTIF-based newlib stubs)

# ---- Tool paths ---- #
# Use system riscv64-unknown-elf-gcc (Ubuntu package with libgcc.a),
# pointed at our custom newlib sysroot for headers + libc.
# Use riscv64-linux-gnu-gcc (full toolchain with libgcc) in bare-metal mode.
# The custom riscv64-unknown-elf-gcc is stage1 only (no libgcc yet).
GCC        ?= riscv64-linux-gnu-gcc
GCC_INCLUDE ?= /usr/lib/gcc-cross/riscv64-linux-gnu/13/include
LIBGCC     ?= /usr/lib/gcc-cross/riscv64-linux-gnu/13/libgcc.a
LIBGCC_EH  ?= /usr/lib/gcc-cross/riscv64-linux-gnu/13/libgcc_eh.a
LITMUS7    ?= /home/ra4ing/.opam/default/bin/litmus7
LITMUS7_SHARE ?= /home/ra4ing/.opam/default/share/herdtools7/litmus
SPIKE      ?= /home/ra4ing/workspace/riscv/bin/spike
NEWLIB_SYSROOT ?= /home/ra4ing/workspace/riscv/riscv64-unknown-elf

# ---- Test configuration ---- #
LITMUS     ?= $(error Set LITMUS=path/to/test.litmus)
AVAIL      ?= 2      # number of harts (must match spike -pN)

# ---- Derived paths ---- #
HARNESS_DIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
LITMUS_NAME := $(basename $(notdir $(LITMUS)))
BUILD_DIR   := build/$(LITMUS_NAME)
GEN_DIR     := $(BUILD_DIR)/gen
ELF         := $(BUILD_DIR)/$(LITMUS_NAME).elf

NRUNS      ?= 2
SIZE       ?= 20

# ---- Compiler flags ---- #
CFLAGS := \
    -O2 -g \
    -march=rv64gc \
    -mabi=lp64d \
    -mcmodel=medany \
    -static \
    -ffreestanding \
    -fno-PIE \
    -nostartfiles \
    -nostdinc \
    -DAVAIL=$(AVAIL) \
    -DCPUS_DEFINED \
    -DFORCE_AFFINITY \
    -include $(HARNESS_DIR)/mbar.h \
    -I$(HARNESS_DIR) \
    -I$(GEN_DIR) \
    -isystem $(GCC_INCLUDE) \
    -I$(NEWLIB_SYSROOT)/include

LDFLAGS := \
    -T $(HARNESS_DIR)/linker.ld \
    -static \
    -nostdlib \
    -nodefaultlibs \
    -Wl,--allow-multiple-definition \
    -Wl,--start-group \
    -L$(NEWLIB_SYSROOT)/lib \
    -lc \
    $(LIBGCC) \
    $(LIBGCC_EH) \
    -Wl,--end-group

# ---- Source files ---- #
# Generated by litmus7: <test>.c utils.c litmus_io.c platform_io.c litmus_rand.c
# affinity.c is excluded — replaced by our affinity_stub.c
# NOTE: run.c and topology.c are inlined into <test>.c by newer litmus7 versions
GEN_SRCS := $(GEN_DIR)/$(LITMUS_NAME).c \
            $(GEN_DIR)/utils.c \
            $(GEN_DIR)/litmus_io.c \
            $(GEN_DIR)/platform_io.c \
            $(GEN_DIR)/litmus_rand.c

# Our harness files (affinity_stub.c replaces generated affinity.c)
HARNESS_SRCS := \
    $(HARNESS_DIR)/spike_hart.c \
    $(HARNESS_DIR)/syscalls.c \
    $(HARNESS_DIR)/affinity_stub.c

# Assembly entry
HARNESS_ASM := $(HARNESS_DIR)/startup.S

# HARNESS_SRCS must come before GEN_SRCS so our launch/join/mmap_exec win
# over utils.c's pthread-based versions (--allow-multiple-definition: first wins)
ALL_SRCS := $(HARNESS_ASM) $(HARNESS_SRCS) $(GEN_SRCS)

# ---- Default target ---- #
.PHONY: all run clean generate compile

all: run

SPIKE_HARTS := $(shell echo $$(($(AVAIL)+1)))

run: compile
	@echo "=== Running $(LITMUS_NAME) on spike ($(SPIKE_HARTS) harts: 1 main + $(AVAIL) workers) ==="
	@echo "=== Results are complete once 'Observation' line appears. Press Ctrl+C to exit spike. ==="
	$(SPIKE) -p$(SPIKE_HARTS) $(ELF)

compile: generate $(GEN_DIR)/$(LITMUS_NAME).h $(ELF)

# ---- Generate C from .litmus ---- #
generate: $(GEN_DIR)/.generated

$(GEN_DIR)/.generated: $(LITMUS)
	@mkdir -p $(GEN_DIR)
	@echo "=== Generating C from $(LITMUS) ==="
	cd $(dir $(LITMUS)) && \
	    $(LITMUS7) -mach riscv -mode presi -stdio false \
	    -avail $(AVAIL) -o $(abspath $(GEN_DIR)) $(abspath $(LITMUS))
	cp $(HARNESS_DIR)/affinity.h $(GEN_DIR)/affinity.h
	cp $(LITMUS7_SHARE)/_toh_nostdio.sh $(GEN_DIR)/toh.sh
	sed -i 's/^#define NUMBER_OF_RUN .*/#define NUMBER_OF_RUN $(NRUNS)/' $(GEN_DIR)/$(LITMUS_NAME).c
	sed -i 's/^#define SIZE_OF_TEST .*/#define SIZE_OF_TEST $(SIZE)/' $(GEN_DIR)/$(LITMUS_NAME).c
	@touch $@

# ---- Generate <test>.h (assembly header required by <test>.c) ---- #
# litmus7 generates a .c that #includes <test>.h, which is produced by:
#   1. Compile with -DASS -S to get assembly
#   2. show.awk extracts the _litmus_P* function bodies
#   3. toh.sh wraps them in a static ass() C function
$(GEN_DIR)/$(LITMUS_NAME).h: $(GEN_DIR)/.generated
	@echo "=== Generating $(LITMUS_NAME).h from assembly ==="
	$(GCC) $(CFLAGS) -DASS -S -o $(GEN_DIR)/$(LITMUS_NAME).s $(GEN_DIR)/$(LITMUS_NAME).c
	awk -f $(GEN_DIR)/show.awk $(GEN_DIR)/$(LITMUS_NAME).s > $(GEN_DIR)/$(LITMUS_NAME).t
	sh $(GEN_DIR)/toh.sh $(GEN_DIR)/$(LITMUS_NAME).t > $@

# ---- Compile + Link ---- #
$(ELF): $(GEN_DIR)/.generated $(GEN_DIR)/$(LITMUS_NAME).h $(ALL_SRCS) $(HARNESS_DIR)/linker.ld
	@mkdir -p $(dir $@)
	@echo "=== Compiling $(LITMUS_NAME) ==="
	$(GCC) $(CFLAGS) \
	    $(ALL_SRCS) \
	    $(LDFLAGS) \
	    -o $@
	@echo "=== ELF ready: $@ ==="

clean:
	rm -rf build/
